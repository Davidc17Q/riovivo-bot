# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
# Modelo de conversación. Si se deja vacío usa claude-haiku-5-5 (rápido y económico).
ANTHROPIC_MODEL=
# Opcional: low | medium | high. Vacío = valor por defecto del modelo.
ANTHROPIC_EFFORT=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Recomendado en producción: "Clave secreta de la app" de Meta, para validar la firma del webhook.
WHATSAPP_APP_SECRET=
# Número del dueño para notificaciones (formato internacional, sin +).
OWNER_WHATSAPP=573113470053

# --- Servidor ---
# PostgreSQL. Local: coincide con docker-compose.yml. En producción (Railway) usa la URL del Postgres gestionado.
DATABASE_URL="postgresql://bot:bot_local@localhost:5434/riovivo_bot?schema=public"
PORT=3000
TIMEZONE=America/Bogota
# Token para los endpoints /admin/* (si se deja vacío, quedan deshabilitados).
ADMIN_TOKEN=
# /test/chat se habilita solo fuera de producción, o con ENABLE_TEST_CHAT=true.
ENABLE_TEST_CHAT=
LOG_LEVEL=info
