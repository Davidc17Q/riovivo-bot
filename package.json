{
  "name": "asistente-whatsapp",
  "version": "1.0.0",
  "private": true,
  "description": "Asistente de WhatsApp con IA, multi-tenant (primer tenant: Río Vivo Spa)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
